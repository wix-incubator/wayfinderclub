---
import Layout from "../layouts/Layout.astro";
import SuccessMessage from "../components/SuccessMessage.astro";
import Button from "../components/Button.astro";
---

<Layout
  title="Expedition Registration Received | Wayfinder Club"
  description="Wayfinder Club expedition registration confirmation."
>
  <div class="success-page site-shell">
    <SuccessMessage
      title="Your route request is in."
      message="Your expedition registration has been submitted through Wix Headless. The Wayfinder team can now review your itinerary interests, capacity fit, and travel notes."
    >
      <div class="success-actions">
        <a href="/" class="inline-block">
          <Button variant="primary">Return to Home</Button>
        </a>
      </div>
    </SuccessMessage>
  </div>
</Layout>
